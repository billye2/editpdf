{
  "manifest_version": 3,
  "name": "PDF Edna: Edit PDF Text, Fix Typos, Move Any Text",
  "version": "1.7.2",
  "description": "PDF text editing made easy — edit the actual text of PDFs, including OCR'd scans, entirely in your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open PDF Edna",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
